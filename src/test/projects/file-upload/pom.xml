<?xml version="1.0" encoding="UTF-8"?>
<project>

  <modelVersion>4.0.0</modelVersion>
  <groupId>org.codehaus.mojo</groupId>
  <artifactId>wagon-maven-plugin</artifactId>
  <packaging>pom</packaging>
  <version>testing</version>

  <build>
    <!-- no wagon extension: the plugin brings the file provider itself -->
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>wagon-maven-plugin</artifactId>
        <version>${it-plugin.version}</version>
        <executions>
          <execution>
            <id>file-upload-single</id>
            <phase>package</phase>
            <goals>
              <goal>upload-single</goal>
            </goals>
            <configuration>
              <fromFile>${basedir}/pom.xml</fromFile>
              <toFile>single/pom.xml</toFile>
              <url>${project.baseUri}target/repo</url>
            </configuration>
          </execution>
          <execution>
            <id>file-download-single</id>
            <phase>verify</phase>
            <goals>
              <goal>download-single</goal>
            </goals>
            <configuration>
              <fromFile>single/pom.xml</fromFile>
              <toDir>${project.build.directory}/downloaded</toDir>
              <url>${project.baseUri}target/repo</url>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
